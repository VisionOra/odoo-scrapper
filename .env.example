
ODOO_URL=https://your-instance.odoo.com

ODOO_EMAIL=you@example.com

ODOO_PASSWORD=your-password-here

# ─── HIPAA-style controls (see COMPLIANCE.md) ────────────────────────────────
# Encrypt the output at rest with AES (Fernet). ON by default.
# Generate a key with:  python -m odoo_extract.crypto
ENCRYPT_OUTPUT=true
PHI_ENCRYPTION_KEY=
# Append-only, hash-chained PHI access audit log (§164.312(b)).
AUDIT_LOG_FILE=phi_audit.log
# Allow plain http:// (NEVER for real PHI — local testing escape hatch only).
ALLOW_INSECURE_HTTP=false

# ─── Optional (sensible defaults shown) ──────────────────────────────────────
# Which customer's invoice to drill into. Kept configurable, never hardcoded.
# Challenge target is "Deco Addict" (requires Odoo demo data loaded). If demo
# data is not present, set this to a customer that exists in your instance,
# e.g. "Mitchell Admin".
TARGET_CUSTOMER=Deco Addict
# true = headless (real run). false = watch the browser while debugging.
HEADLESS=true
# Base name for the output. With encryption on, the file is written as
# "<OUTPUT_FILE>.enc".
OUTPUT_FILE=invoice_lines.json
# Persistent browser profile dir (cookies/session survive between runs).
USER_DATA_DIR=.pw-profile
# Console verbosity: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO
# Save failure.png + trace.zip on error. These contain UNREDACTED data — set to
# false where writing raw page content to disk is unacceptable.
SAVE_ARTIFACTS=trues
# Add Chromium --no-sandbox (only in a hardened container; weakens isolation).
NO_SANDBOX=false
